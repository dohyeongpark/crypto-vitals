# .env.example — 실제 값을 채워 .env 로 복사하세요. .env는 .gitignore에 포함됩니다.
#
# Binance API 키는 불필요합니다.
# 이 프로젝트는 공개 시장 데이터(data.binance.vision, public REST endpoints)만 사용합니다.

# ── TimescaleDB ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptodb
DB_USER=postgres
DB_PASSWORD=change_me_strong_password

# ── 수집 설정 ─────────────────────────────────────────────────────────────────
# 피처 계산 rolling window (시간 단위)
FEATURE_WINDOW_H=168

# pair_features 버전 태그
FEATURE_VERSION=v0.1-ols
